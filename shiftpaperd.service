[Unit]
Description=Shiftpaper parallax wallpaper daemon
Documentation=https://github.com/CPritch/shiftpaper
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Resolved from PATH — works for both cargo install (~/.cargo/bin) and
# packaged installs (/usr/bin). If this fails, add:
#   Environment="PATH=/usr/bin:%h/.cargo/bin"
ExecStart=shiftpaperd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
