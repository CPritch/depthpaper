[Unit]
Description=Shiftpaper parallax wallpaper daemon
Documentation=https://github.com/CPritch/shiftpaper
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/shiftpaperd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
